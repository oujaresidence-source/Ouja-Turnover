{
  "_comment": "«حكمة الأسبوع» — owner-editable. Only lines in this file can ever appear; the model never writes one. Rotates by issue number. `by` is printed under the line (a folk proverb says «مثل شعبي»).",
  "sayings": [
    {"id": "s01", "text": "اللي ما يعرف الصقر يشويه", "by": "مثل شعبي"},
    {"id": "s02", "text": "الطيب ما يضيع", "by": "مثل نجدي"},
    {"id": "s03", "text": "من جدّ وجد، ومن زرع حصد", "by": "مثل عربي"},
    {"id": "s04", "text": "الصبر مفتاح الفرج", "by": "مثل عربي"},
    {"id": "s05", "text": "اللي يبي العلا يسهر الليالي", "by": "مثل شعبي"},
    {"id": "s06", "text": "رفيق الدرب قبل الدرب", "by": "مثل عربي"},
    {"id": "s07", "text": "ما طار طير وارتفع إلا كما طار وقع", "by": "مثل عربي"},
    {"id": "s08", "text": "الجار قبل الدار", "by": "مثل عربي"},
    {"id": "s09", "text": "خير الكلام ما قلّ ودلّ", "by": "مثل عربي"},
    {"id": "s10", "text": "اللي فات مات، والجاي أحلى", "by": "مثل شعبي"},
    {"id": "s11", "text": "الكريم إذا وعد وفى", "by": "مثل عربي"},
    {"id": "s12", "text": "الحركة بركة", "by": "مثل عربي"},
    {"id": "s13", "text": "ما حكّ جلدك مثل ظفرك", "by": "مثل عربي"},
    {"id": "s14", "text": "الوقت كالسيف، إن لم تقطعه قطعك", "by": "حكمة عربية"},
    {"id": "s15", "text": "اعمل خيراً وارمه بالبحر", "by": "مثل شعبي"},
    {"id": "s16", "text": "من راقب الناس مات همّاً", "by": "مثل عربي"},
    {"id": "s17", "text": "الضحك من غير سبب من قلّة الأدب، والضحك مع الأحباب من حسن الأدب", "by": "مثل شعبي"},
    {"id": "s18", "text": "الديرة ما تضيق بأهلها", "by": "مثل نجدي"},
    {"id": "s19", "text": "الرزق يحب الخفية", "by": "مثل عربي"},
    {"id": "s20", "text": "من صبر ظفر", "by": "مثل عربي"}
  ]
}
